{
	"name": "stroycommute",
	"displayName": "StroyCommute",
	"author": "DestCom - StroyCo",
	"version": "1.0.0",
	"license": "GPL-3.0-only",
	"keywords": [
		"pebble-app"
	],
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"lint": "biome check .",
		"format": "biome format --write .",
		"postinstall": "patch-package",
		"test": "node --test \"test/**/*.test.js\"",
		"sync:config": "node scripts/sync-config-html.js",
		"check:config": "node scripts/sync-config-html.js --check"
	},
	"pebble": {
		"displayName": "StroyCommute",
		"uuid": "1536ae22-1710-418b-9ddb-e43eda1842aa",
		"projectType": "moddable",
		"sdkVersion": "3",
		"enableMultiJS": true,
		"targetPlatforms": [
			"emery"
		],
		"watchapp": {
			"watchface": false
		},
		"capabilities": [
			"configurable"
		],
		"messageKeysNote": "JSON has no comments, so this field carries the warning instead: order matters here and must exactly match ALL_MESSAGE_KEYS in src/embeddedjs/main.js (10000 + array-index numbering). Keep both in sync on any add/remove/reorder -- see that file's comment for why.",
		"messageKeys": [
			"itemIndex",
			"itemCount",
			"itemType",
			"scheduleDaysBitmask",
			"scheduleStartMinutes",
			"scheduleEndMinutes",
			"timelineEnabled",
			"stopRef",
			"lineRef",
			"lineName",
			"stopName",
			"state",
			"destination",
			"minutes",
			"atStop",
			"cancelled",
			"lineColor",
			"lineTextColor",
			"minutes2",
			"quotaRemaining",
			"language",
			"destStopRef",
			"destStopName",
			"mission",
			"mission2"
		],
		"resources": {
			"media": [
				{
					"menuIcon": true,
					"type": "png",
					"name": "IMAGE_ICON",
					"file": "images/icon.png"
				}
			]
		}
	},
	"dependencies": {
		"@moddable/pebbleproxy": "^0.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"patch-package": "^8.0.1"
	}
}
